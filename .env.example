# --- Next.js server (never prefix with NEXT_PUBLIC_) ---
SITE_URL=https://example.invalid
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=otomater
# Shared secret between Next.js and the Odoo addon (Odoo: Settings > Technical > System Parameters > otomater_website.api_key)
ODOO_API_KEY=change-me-long-random
# HMAC secret for the admin session cookie (>= 32 chars)
SESSION_SECRET=change-me-at-least-32-characters-long
# Secret used by Odoo to call POST /api/revalidate after publishing
REVALIDATE_SECRET=change-me-another-random-value
CONTENT_REVALIDATE_S=300
CONTENT_TIMEOUT_MS=4000
