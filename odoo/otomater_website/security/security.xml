<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_otm_website" model="res.groups.privilege">
        <field name="name">Otomater Website</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>
    <record id="group_otm_website_editor" model="res.groups">
        <field name="name">Website Editor</field>
        <field name="privilege_id" ref="privilege_otm_website"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_otm_website_lead" model="res.groups">
        <field name="name">Lead Manager</field>
        <field name="privilege_id" ref="privilege_otm_website"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_otm_website_admin" model="res.groups">
        <field name="name">Website Administrator</field>
        <field name="privilege_id" ref="privilege_otm_website"/>
        <field name="implied_ids" eval="[(4, ref('group_otm_website_editor')), (4, ref('group_otm_website_lead'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
