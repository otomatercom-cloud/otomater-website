<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_website_lead_list" model="ir.ui.view">
        <field name="name">otm.website.lead.list</field>
        <field name="model">otm.website.lead</field>
        <field name="arch" type="xml">
            <list>
                <field name="submitted_date"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="service"/>
                <field name="source_page"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_otm_website_lead_form" model="ir.ui.view">
        <field name="name">otm.website.lead.form</field>
        <field name="model">otm.website.lead</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="status" widget="statusbar" options="{'clickable': '1'}"/></header>
                <sheet>
                    <group name="grp_contact">
                        <group><field name="name"/><field name="email"/><field name="phone"/><field name="company"/></group>
                        <group><field name="service"/><field name="submitted_date"/><field name="consent"/><field name="consent_date"/></group>
                    </group>
                    <group name="grp_message"><field name="message"/></group>
                    <group name="grp_source" string="Source">
                        <group><field name="source_page"/><field name="referrer"/></group>
                        <group><field name="utm_source"/><field name="utm_medium"/><field name="utm_campaign"/></group>
                    </group>
                    <group name="grp_notes"><field name="notes"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_otm_website_lead_search" model="ir.ui.view">
        <field name="name">otm.website.lead.search</field>
        <field name="model">otm.website.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="email"/><field name="phone"/><field name="company"/>
                <filter name="f_new" string="New" domain="[('status', '=', 'new')]"/>
                <separator/>
                <group>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="g_service" string="Service" context="{'group_by': 'service'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_otm_website_lead" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">otm.website.lead</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
